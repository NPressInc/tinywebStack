# Copy to config/local.env on spark (never commit local.env).
# shellcheck disable=SC2034

# Repo checkout (example on spark):
# cd ~/Documents/codingProj/tinywebStack

LIBVIRT_DEFAULT_URI="qemu:///system"

TW_STACK_VM_DIR="/var/lib/libvirt/images/tinywebstack"
TW_STACK_IMAGE_DIR="${TW_STACK_VM_DIR}/images"

FEDERATION_IP_RANGE_WHITELIST="192.168.122.0/24"

PROVISION_SSH_USER="twsadmin"
REMOTE_SSH_USER="root"
ADMIN_SSH_PUBKEY="${HOME}/.ssh/id_ed25519.pub"

YUNOHOST_ADMIN_USER="twsowner"

LOCATION_APP="owntracks"
EVENTS_APP="mobilizon"
TWS_NEXTCLOUD_PATH="/nextcloud"
LAB_PASSWORD="dummydummy"

TW_STACK_SECRETS_DIR="${HOME}/.tinywebstack-secrets"
TW_STACK_SECRETS_FILE="${TW_STACK_SECRETS_DIR}/passwords.env"

# Optional lab convenience: same password for every generated test secret (admin, alice, bob,
# parent, kid, Traccar admin). Never set on real deployments. Minimum 8 characters for YunoHost.
# LAB_PASSWORD="your-long-lab-secret"
