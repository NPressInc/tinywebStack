# Copy to config/local.env on spark (never commit local.env).
# shellcheck disable=SC2034

# Host that runs KVM (William's machine)
SPARK_HOST="$(hostname -s)"

# Where Debian cloud images and VM disks live on spark
TW_STACK_IMAGE_DIR="${HOME}/tinywebstack/images"
TW_STACK_VM_DIR="${HOME}/tinywebstack/vms"

# Debian cloud image (download once with scripts/spark/fetch-debian-cloud-image.sh)
DEBIAN_CLOUD_IMAGE="${TW_STACK_IMAGE_DIR}/debian-12-genericcloud-amd64.qcow2"

# Default VM sizing (override per node in nodes.conf)
DEFAULT_VM_RAM_MB=4096
DEFAULT_VM_VCPUS=2
DEFAULT_VM_DISK_GB=32

# libvirt network (usually "default" NAT)
LIBVIRT_NETWORK="default"

# SSH public key path on spark for provisioning (password auth disabled after install)
ADMIN_SSH_PUBKEY="${HOME}/.ssh/id_ed25519.pub"

# Base domain for private test DNS (RFC 6761 reserved; use hosts file + optional dnsmasq)
TEST_DOMAIN_SUFFIX="family.test"

# YunoHost admin (first domain = main domain)
# YUNOHOST_ADMIN_PASSWORD is prompted or generated; do not store in git.

# OwnTracks app (testing branch URL is common for YunoHost third-party apps)
OWNTRACKS_APP_URL="https://github.com/YunoHost-Apps/owntracks_ynh"
