# Copy to config/local.env on spark (never commit local.env).
# shellcheck disable=SC2034

# Repo checkout (example on spark):
# cd ~/Documents/codingProj/tinywebStack

LIBVIRT_DEFAULT_URI="qemu:///system"

TW_STACK_VM_DIR="/var/lib/libvirt/images/tinywebstack"
TW_STACK_IMAGE_DIR="${TW_STACK_VM_DIR}/images"

FEDERATION_IP_RANGE_WHITELIST="192.168.122.0/24"

PROVISION_SSH_USER="twsadmin"
REMOTE_SSH_USER="root"
ADMIN_SSH_PUBKEY="${HOME}/.ssh/id_ed25519.pub"

YUNOHOST_ADMIN_USER="twsowner"

LOCATION_APP="owntracks"
EVENTS_APP="mobilizon"
TWS_NEXTCLOUD_PATH="/nextcloud"
LAB_PASSWORD="dummydummy"

# Family members provisioned by create-family-test-users.sh / setup-family-calendars.sh
# (comma-separated). Uncomment for a real-named household; default is the lab pair.
# TWS_FAMILY_USERS="william,sophie,emma"

TW_STACK_SECRETS_DIR="${HOME}/.tinywebstack-secrets"
TW_STACK_SECRETS_FILE="${TW_STACK_SECRETS_DIR}/passwords.env"

# Optional: realistic participant names for the e2e verifiers / matrix test users.
# Uncomment to override the alice/bob federation pair and parent/kid lab defaults.
# The family household itself is TWS_FAMILY_USERS above. Passwords for custom
# names come from $<USERNAME>_PASSWORD (exported or in passwords.env) or the
# <USERNAME>_PASSWORD_<NODE> keys that ensure-node-secrets.sh can generate.
# TWS_ALICE_USER="maya"
# TWS_BOB_USER="ravi"
# TWS_PARENT_USER="mom.dad"
# TWS_KID_USER="junior"

# Optional: prebuilt wheel for the Synapse family module (S5.4). Leave empty
# to install from the synced repo source (default). Set to a wheel path built
# on the control machine (python -m pip wheel --no-deps -w dist
# family/synapse_module) to install a pinned artifact. After `yunohost app
# upgrade synapse`, run scripts/vm/family-module-post-upgrade.sh (via
# remote-run.sh) to detect the wipe and re-apply. See docs/module-packaging.md.
# TWS_FAMILY_MODULE_WHEEL="/root/dist/tinywebstack_family-0.1.0-py3-none-any.whl"

# Optional lab convenience: same password for every generated test secret (admin, alice, bob,
# parent, kid, Traccar admin). Never set on real deployments. Minimum 8 characters for YunoHost.
# LAB_PASSWORD="your-long-lab-secret"
