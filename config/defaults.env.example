# Copy to config/local.env on spark (never commit local.env).
# shellcheck disable=SC2034

# Repo checkout on spark (do not use the same path as VM data dirs)
# Example: TW_STACK_ROOT=/home/william/Documents/codingProj/tinywebStack

LIBVIRT_DEFAULT_URI="qemu:///system"

TW_STACK_IMAGE_DIR="${HOME}/.tinywebstack/images"
TW_STACK_VM_DIR="/var/lib/libvirt/images/tinywebstack"

DEFAULT_VM_RAM_MB=4096
DEFAULT_VM_VCPUS=2
DEFAULT_VM_DISK_GB=32

LIBVIRT_NETWORK="default"

PROVISION_SSH_USER="twsadmin"
ADMIN_SSH_PUBKEY="${HOME}/.ssh/id_ed25519.pub"

YUNOHOST_ADMIN_USER="twsadmin"

TEST_DOMAIN_SUFFIX="family.test"

OWNTRACKS_APP_URL="https://github.com/YunoHost-Apps/owntracks_ynh"

TW_STACK_SECRETS_DIR="${HOME}/.tinywebstack-secrets"
TW_STACK_SECRETS_FILE="${TW_STACK_SECRETS_DIR}/passwords.env"

YUNOHOST_INSTALL_URL="https://install.yunohost.org"
TW_STACK_LAB_CA_DIR="${TW_STACK_SECRETS_DIR}/lab-ca"
