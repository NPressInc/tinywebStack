# TinyWeb-operated push ids for every family box.
# Copy to /etc/tinywebstack/secrets/push/operator.env and chmod 600.
# Do not commit a filled-in copy. Do not put key material in tinyweb.env.
#
# The APNs .p8 and the Firebase service-account JSON live next to this file
# (or arrive as TWS_APNS_KEY / TWS_FCM_SERVICE_ACCOUNT_JSON in the environment).
# Unit tests do not need real values. See docs/PUSH.md.

# 10-character id of the TinyWeb APNs auth key. Leave empty in the example.
TWS_APNS_KEY_ID=
# 10-character Apple team id for the TinyWeb developer account.
TWS_APNS_TEAM_ID=
# Bundle id of the TinyWeb iOS app. Topic sent to APNs.
TWS_APNS_BUNDLE_ID=win.tinyweb.tinyweb
# production for family boxes. sandbox only for an APNs sandbox build.
TWS_APNS_ENV=production
# Optional. Read from the service account JSON when unset.
# TWS_FCM_PROJECT_ID=
