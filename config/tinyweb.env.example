# One-box installer settings (copy to /etc/tinywebstack/tinyweb.env or ./tinyweb.env).
# Secrets are generated on the box into /etc/tinywebstack/secrets/install.env — do not put passwords here.

# Required: main YunoHost / Matrix server name (e.g. home.example.com).
TWS_DOMAIN=home.example.com

# Spark-style node id (letters, digits, hyphen, underscore). Default: first label of TWS_DOMAIN.
# TWS_NODE_NAME=home-a

# lab = private CA / LAB_PASSWORD; production = Let's Encrypt + random secrets.
TWS_MODE=production

# YunoHost admin LDAP user (default twsowner).
# TWS_ADMIN_USER=twsowner

# Location app: owntracks (default) or traccar.
# LOCATION_APP=owntracks

# Events app (Mobilizon from YunoHost catalog).
# EVENTS_APP=mobilizon

# Real household (production): set all three; lab default is parent,kid.
# TWS_FAMILY_USERS=william,sophie,emma
# TWS_FAMILY_PARENTS=william,sophie
# TWS_FAMILY_KIDS=emma
# TWS_FAMILY_OWNER=william

# Optional Let's Encrypt contact (production).
# TWS_LE_EMAIL=admin@example.com

# Lab only: directory with per-FQDN fullchain.pem/privkey.pem and lab-ca.crt.pem.
# TWS_LAB_CERTS_DIR=/path/to/lab-certs

# Lab only: extra /etc/hosts lines for peer VMs (copied to /opt/tinywebstack/peers.hosts).
# TWS_PEERS_HOSTS_FILE=/path/to/peers.hosts

# Swap: auto (create 2G swap if RAM < 6G), off, or size in MB.
# TWS_SWAP=auto

# Lab only: shared password for all generated accounts (min 8 chars). Never use in production.
# LAB_PASSWORD=changeme-lab-only

# Dashboard / federation TLS verify: 0 production, 1 lab (defaults follow TWS_MODE).
# TWS_LAB_TLS_INSECURE=0

# Lab federation allowlist CIDR (Synapse snippet).
# FEDERATION_IP_RANGE_WHITELIST=192.168.122.0/24
