# Non-secret defaults (override in config/local.env on spark).
# shellcheck disable=SC2034

LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

TW_STACK_VM_DIR="${TW_STACK_VM_DIR:-/var/lib/libvirt/images/tinywebstack}"
TW_STACK_IMAGE_DIR="${TW_STACK_IMAGE_DIR:-${TW_STACK_VM_DIR}/images}"

DEBIAN_CLOUD_IMAGE="${DEBIAN_CLOUD_IMAGE:-}"

DEFAULT_VM_RAM_MB="${DEFAULT_VM_RAM_MB:-4096}"
DEFAULT_VM_VCPUS="${DEFAULT_VM_VCPUS:-2}"
DEFAULT_VM_DISK_GB="${DEFAULT_VM_DISK_GB:-32}"

LIBVIRT_NETWORK="${LIBVIRT_NETWORK:-default}"
FEDERATION_IP_RANGE_WHITELIST="${FEDERATION_IP_RANGE_WHITELIST:-192.168.122.0/24}"

PROVISION_SSH_USER="${PROVISION_SSH_USER:-twsadmin}"
REMOTE_SSH_USER="${REMOTE_SSH_USER:-root}"
ADMIN_SSH_PUBKEY="${ADMIN_SSH_PUBKEY:-${HOME}/.ssh/id_ed25519.pub}"

YUNOHOST_ADMIN_USER="${YUNOHOST_ADMIN_USER:-twsowner}"

TEST_DOMAIN_SUFFIX="${TEST_DOMAIN_SUFFIX:-family.test}"

# owntracks = default (Recorder + mobile app); set LOCATION_APP=traccar for catalog-only fallback
LOCATION_APP="${LOCATION_APP:-owntracks}"

# Family events (Facebook Events equivalent): Mobilizon from YunoHost catalog (arm64 supported).
EVENTS_APP="${EVENTS_APP:-mobilizon}"
MOBILIZON_REJECT_PROBE="${MOBILIZON_REJECT_PROBE:-mobilizon.fr}"

OWNTRACKS_APP_URL="${OWNTRACKS_APP_URL:-https://github.com/YunoHost-Apps/owntracks_ynh}"
OWNTRACKS_APT_KEY_URL="${OWNTRACKS_APT_KEY_URL:-https://raw.githubusercontent.com/owntracks/recorder/master/etc/repo-v2.owntracks.org.gpg.key}"

TW_STACK_SECRETS_DIR="${TW_STACK_SECRETS_DIR:-${HOME}/.tinywebstack-secrets}"
TW_STACK_SECRETS_FILE="${TW_STACK_SECRETS_FILE:-${TW_STACK_SECRETS_DIR}/passwords.env}"
TW_STACK_SSH_KNOWN_HOSTS="${TW_STACK_SSH_KNOWN_HOSTS:-${TW_STACK_SECRETS_DIR}/known_hosts}"

YUNOHOST_INSTALL_URL="${YUNOHOST_INSTALL_URL:-https://install.yunohost.org}"

TW_STACK_LAB_CA_DIR="${TW_STACK_LAB_CA_DIR:-${TW_STACK_SECRETS_DIR}/lab-ca}"

VM_AUTOSTART="${VM_AUTOSTART:-1}"

# Lab only (test VMs): one password for all generated node secrets. Leave unset in production.
# YunoHost user/admin passwords must be at least 8 characters or creation will fail.
LAB_PASSWORD="${LAB_PASSWORD:-}"
