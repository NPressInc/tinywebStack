# Non-secret defaults (override in config/local.env on spark).
# shellcheck disable=SC2034

LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

TW_STACK_IMAGE_DIR="${TW_STACK_IMAGE_DIR:-${HOME}/.tinywebstack/images}"
TW_STACK_VM_DIR="${TW_STACK_VM_DIR:-/var/lib/libvirt/images/tinywebstack}"

DEBIAN_CLOUD_IMAGE="${DEBIAN_CLOUD_IMAGE:-}"

DEFAULT_VM_RAM_MB="${DEFAULT_VM_RAM_MB:-4096}"
DEFAULT_VM_VCPUS="${DEFAULT_VM_VCPUS:-2}"
DEFAULT_VM_DISK_GB="${DEFAULT_VM_DISK_GB:-32}"

LIBVIRT_NETWORK="${LIBVIRT_NETWORK:-default}"

PROVISION_SSH_USER="${PROVISION_SSH_USER:-twsadmin}"
ADMIN_SSH_PUBKEY="${ADMIN_SSH_PUBKEY:-${HOME}/.ssh/id_ed25519.pub}"

YUNOHOST_ADMIN_USER="${YUNOHOST_ADMIN_USER:-twsadmin}"

TEST_DOMAIN_SUFFIX="${TEST_DOMAIN_SUFFIX:-family.test}"

OWNTRACKS_APP_URL="${OWNTRACKS_APP_URL:-https://github.com/YunoHost-Apps/owntracks_ynh}"

TW_STACK_SECRETS_DIR="${TW_STACK_SECRETS_DIR:-${HOME}/.tinywebstack-secrets}"
TW_STACK_SECRETS_FILE="${TW_STACK_SECRETS_FILE:-${TW_STACK_SECRETS_DIR}/passwords.env}"

YUNOHOST_INSTALL_URL="${YUNOHOST_INSTALL_URL:-https://install.yunohost.org}"

TW_STACK_LAB_CA_DIR="${TW_STACK_LAB_CA_DIR:-${TW_STACK_SECRETS_DIR}/lab-ca}"
