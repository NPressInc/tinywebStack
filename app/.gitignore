app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local fastlane install. CI does not bundle this.
.bundle/
vendor/bundle/

# Store signing output and review screenshots. Never commit secrets.
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/.env
fastlane/screenshots/
fastlane/**/*.mobileprovision
fastlane/**/*.p12
fastlane/**/*.cer
