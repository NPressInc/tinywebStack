[Unit]
Description=TinyWeb first-boot setup
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/tinywebstack/unboxing-complete

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/tinywebstack/setup/tinyweb-setupd.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
